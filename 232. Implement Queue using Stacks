💡 Two stacks (full implementation)
📊 O(n), O(n)

class MyQueue {

    Stack<Integer> st = new Stack();
    Stack<Integer> tmp = new Stack();
    int res;

    public MyQueue() {
        
    }
    
    public void push(int x) {
        st.push(x);
    }
    
    public int pop() {
        if (!st.isEmpty()) {
            while(!st.isEmpty()) {
                tmp.push(st.pop());
            }
        }
        if (!tmp.isEmpty()) {
            res = tmp.pop();
            while(!tmp.isEmpty()) {
                st.push(tmp.pop());
            }
        }
        return res;
    }
    
    public int peek() {
        if (!st.isEmpty()) {
            while(!st.isEmpty()) {
                tmp.push(st.pop());
            }
        }
        if (!tmp.isEmpty()) {
            res = tmp.pop();
            st.push(res);
            while(!tmp.isEmpty()) {
                st.push(tmp.pop());
            }
        }
        return res;
    }
    
    public boolean empty() {
        return st.isEmpty();
    }
}

