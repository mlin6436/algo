💡 Boyer-moore alg
📊 O(n), O(1)

class Solution {
    public int majorityElement(int[] nums) {
        Integer res = null;
        int count = 0;
        for (int cur : nums) {
            if (count == 0) {
                res = cur;
            }
            count += (cur == res) ? 1 : -1;
        }
        return res; 
    }
}

