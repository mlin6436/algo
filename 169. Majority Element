💡 Hash map
📊 O(n), O(n)

class Solution {
    public int majorityElement(int[] nums) {
        Map<Integer, Integer> map = new HashMap<>();
        int num = nums[0];
        int count = 1;
        for (int i = 0; i < nums.length; i++) {
            int tmp = map.getOrDefault(nums[i], 0) + 1;
            map.put(nums[i], tmp);
            if (tmp > count) {
                num = nums[i];
                count = tmp;
            }
        }
        return num;
    }
}