💡 Backtracking
📊 O(n * n), O(n)

class Solution {
    private String[] dict = {"0", "1", "abc", "def", "ghi", "jkl", "mno", "pqrs", "tuv", "wxyz"};

    public List<String> letterCombinations(String digits) {
        if (digits.length() == 0) return new ArrayList<>();
        List<String> res = new ArrayList<>();
        bt(digits, 0, "", res);
        return res;
    }

    private void bt(String digits, int idx, String tmp, List<String> res) {
        if (idx == digits.length()) {
            res.add(tmp);
            return;
        }
        String chars = dict[digits.charAt(idx) - '0'];
        for (char c : chars.toCharArray()) {
            bt(digits, idx + 1, new String(tmp + c), res);
        }
    }
}