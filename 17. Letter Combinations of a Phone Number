💡 Backtracking (string builder)
📊 O(n * n), O(n)

class Solution {
    private String[] dict = {"", "", "abc", "def", "ghi", "jkl", "mno", "pqrs", "tuv", "wxyz"};

    public List<String> letterCombinations(String digits) {
        if (digits.length() == 0) return new ArrayList<>();
        List<String> res = new ArrayList<>();
        bt(digits, 0, new StringBuilder(), res);
        return res;
    }

    private void bt(String digits, int idx, StringBuilder sb, List<String> res) {
        if (idx == digits.length()) {
            res.add(sb.toString());
            return;
        }
        String chars = dict[digits.charAt(idx) - '0'];
        for (char c : chars.toCharArray()) {
            sb.append(c);
            bt(digits, idx + 1, sb, res);
            sb.deleteCharAt(sb.length() - 1);
        }
    }
}

