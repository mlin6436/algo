💡 DP
📊 O(n), O(1)

class Solution {
    public int maxSubArray(int[] nums) {
        int acc = nums[0];
        int max = nums[0];
        for (int i = 1; i < nums.length; i++) {
            acc = Math.max(nums[i], acc + nums[i]);
            max = Math.max(max, acc);
        }
        return max;
    }
}