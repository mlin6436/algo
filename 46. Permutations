💡 Backtracking (swap to generate mutations)
📊 O(n * n!), O(n)

class Solution {
    public List<List<Integer>> permute(int[] nums) {
        List<List<Integer>> res = new ArrayList();
        gen(nums, 0, res);
        return res;
    }
    
    private void gen(int[] nums, int index, List<List<Integer>> res) {
        if (index == nums.length - 1) {
            List<Integer> tmp = new ArrayList();
            for (int num: nums) tmp.add(num);
            res.add(tmp);
            return;
        }
        for (int i = index; i < nums.length; i++) {
            swap(nums, i, index);
            gen(nums, index + 1, res);
            swap(nums, i, index);
        }
    }
    
    private void swap(int[] nums, int x, int y) {
        var temp = nums[x];
        nums[x] = nums[y];
        nums[y] = temp;
    }
}
