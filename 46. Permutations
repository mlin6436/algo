💡 Backtracking (generate mutations)
📊 O(n * n!), O(n)

class Solution {
    public List<List<Integer>> permute(int[] nums) {
        List<List<Integer>> res = new ArrayList<>();
        List<Integer> tmp = new ArrayList<>();
        bt(nums, res, tmp);
        return res;
    }

    public void bt(int[] nums, List<List<Integer>> res, List<Integer> tmp) {
        if (tmp.size() == nums.length) {
            res.add(new ArrayList<>(tmp));
            return;
        }
        for (int num : nums) {
            if (!tmp.contains(num)) {
                tmp.add(num);
                bt(nums, res, tmp);
                tmp.remove(tmp.size() - 1);
            }
        }
    }
}

