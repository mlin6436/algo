💡 Bit-by-bit
📊 O(n), O(n)

class Solution {
    public String addBinary(String a, String b) {
        String res = "";
        int carry = 0;
        int i = a.length();
        int j = b.length();
        while (i > 0 || j > 0) {
            int num1 = i <= 0 ? 0 : a.charAt(i - 1) - '0';
            int num2 = j <= 0 ? 0 : b.charAt(j - 1) - '0';
            int sum = num1 + num2 + carry;
            if (sum == 0) {
                res = "0" + res;
                carry = 0;
            } else if (sum == 1) {
                res = "1" + res;
                carry = 0;
            } else if (sum == 2) {
                res = "0" + res;
                carry = 1;
            } else if (sum == 3) {
                res = "1" + res;
                carry = 1;
            }
            i--;
            j--;
        }
        if (carry == 1) {
            res = "1" + res;
        }
        return res;
    }
}