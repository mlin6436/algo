💡 DP (bottom-up)
📊 O(n), O(n)

class Solution {
    public int climbStairs(int n) {
        if (n <= 2) return n;
        int prev = 1;
        int prevprev = 1;
        int res = 0;
        for (int i = 2; i <= n; i++) {
            res = prev + prevprev;
            prevprev = prev;
            prev = res;
        }
        return res;
    }
}

