💡 Tail Recursion
📊 O(n), O(1)

class Solution {
    public int climbStairs(int n) {
        return climb(n, 0);
    }
    
    private int climb(int n, int res) {
        if (n == 0) {
            return 0;
        } else if (n == 1) {
            return 1;
        } else if (n == 2) {
            return 2;
        } else {
            return climb(n - 1, res) + climb(n - 2, res);    
        }
    }
}

