class Solution {
    public String minWindow(String s, String t) {
        if (t.length() > s.length()) return "";
        Map<Character, Integer> smap = new HashMap<>();
        Map<Character, Integer> tmap = new HashMap<>();
        int count = 0;
        int match = 0;
        String res = "";
        for (char c : t.toCharArray()) {
            tmap.put(c, tmap.getOrDefault(c, 0) + 1);
            count++;
        }
        for (int left = 0, right = 0; right < s.length(); right++) {
            char cur = s.charAt(right);
            if (tmap.containsKey(cur)) {
                smap.put(cur, smap.getOrDefault(cur, 0) + 1);
                if (tmap.get(cur) >= smap.get(cur)) match++;
            }
            while (match == count) {
                if (res.isEmpty() || res.length() > right - left + 1) res = s.substring(left, right + 1);
                char del = s.charAt(left);
                left++;
                if (tmap.containsKey(del)) {
                    smap.put(del, smap.get(del) - 1);
                    if (tmap.get(del) > smap.get(del)) match--;
                }
            }
        }
        return res;
    }
}