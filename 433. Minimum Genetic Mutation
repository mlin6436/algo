💡 DFS
📊 O(n * m^n), O(n) - N is the length of the gene and M is the number of possible characters for mutation

class Solution {
    private Set<String> dict;
    private int min = Integer.MAX_VALUE;
    
    public int minMutation(String startGene, String endGene, String[] bank) {
        dict = new HashSet<String>(Arrays.asList(bank));
        dfs(startGene, endGene, 0);
        return min == Integer.MAX_VALUE ? -1 : min;
    }

    private void dfs(String start, String end, int steps) {
        if (start.equals(end)) {
            min = Math.min(min, steps);
            return;
        }
        for (int i = 0; i < start.length(); i++) {
            for (char c : new char[]{'A','C','G','T'}) {
                char[] cur = start.toCharArray();
                cur[i] = c;
                String s = new String(cur);
                if (dict.contains(s)) {
                    dict.remove(s);
                    dfs(s, end, steps + 1);
                    dict.add(s);
                }
            }
        }
        return;
    }
}