💡 Recursive
📊 O(n), O(n)

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    private int v = 0;

    public TreeNode buildTree(int[] preorder, int[] inorder) {
        Map<Integer, Integer> map = new HashMap<>();
        for (int i = 0; i < inorder.length; i++) {
            map.put(inorder[i], i);
        }
        return preorderTraverse(preorder, 0, inorder.length - 1, map);
    }

    public TreeNode preorderTraverse(int[] preorder, int start, int end, Map<Integer, Integer> map) {
        if (start > end) return null;
        int nodeV = preorder[v++];
        TreeNode node = new TreeNode(nodeV);
        node.left = preorderTraverse(preorder, start, map.get(nodeV) - 1, map);
        node.right = preorderTraverse(preorder, map.get(nodeV) + 1, end, map);
        return node;
    }
}