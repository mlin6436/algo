💡 Setup boundaries
📊 O(mn), O(1)

class Solution {
    public List<Integer> spiralOrder(int[][] matrix) {
        List<Integer> res = new ArrayList();
        int rows = matrix.length;
        int cols = matrix[0].length;
        int minRow = 0;
        int minCol = 0;
        int maxRow = rows - 1;
        int maxCol = cols - 1;
        int curRow = 0;
        int curCol = 0;
        int dir = 0;
        int count = 0;
        while (count < rows * cols) {
            res.add(matrix[curRow][curCol]);
            
            if (dir == 0) {
                if (curCol + 1 <= maxCol) {
                    curCol++;   
                } else {
                    dir = 1;
                    curRow++;
                    minRow++;
                }
            } else if (dir == 1) {
                if (curRow + 1 <= maxRow) {
                    curRow++;   
                } else {
                    dir = 2;
                    curCol--;
                    maxCol--;
                }
            } else if (dir == 2) {
                if (curCol - 1 >= minCol) {
                    curCol--;
                } else {
                    dir = 3;
                    curRow--;
                    maxRow--;
                }
            } else {
                if (curRow - 1 >= minRow) {
                    curRow--;   
                } else {
                    dir = 0;
                    curCol++;
                    minCol++;
                }
            }
            
            count++;
        }
        
        return res;
    }
}
