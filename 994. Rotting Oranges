💡 BFS
📊 O(m*n), O(m*n)

class Solution {
    public int orangesRotting(int[][] grid) {
        int m = grid.length;
        int n = grid[0].length;
        int fresh = 0;
        Queue<int[]> q = new LinkedList<>();
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (grid[i][j] == 2) {
                    q.offer(new int[]{i,j});
                } else if (grid[i][j] == 1) {
                    fresh++;
                }
            }
        }
        if (fresh == 0) return 0;

        int res = 0;
        int[][] dirs = {{-1,0},{0,-1},{1,0},{0,1}};
        while (!q.isEmpty()) {
            int size = q.size();
            while (size > 0) {
                int[] cur = q.poll();
                for (int[] dir : dirs) {
                    int r = cur[0] + dir[0];
                    int c = cur[1] + dir[1];
                    if (r >= 0 && r < m && c >= 0 && c < n && grid[r][c] == 1) {
                        grid[r][c] = 2;
                        q.offer(new int[]{r,c});
                        fresh--;
                    }
                }
                size--;
            }
            if (q.size() != 0) res++;
        }
        return (fresh == 0) ? res : -1;
    }
}

