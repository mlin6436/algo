💡 DP
📊 O(mn), O(mn)

class Solution {
    public int uniquePaths(int m, int n) {
        int[][] dp = new int[m][n];
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (i == 0 || j == 0) dp[i][j] = 1;
                else dp[i][j] = dp[i - 1][j] + dp[i][j - 1];
            }
        }
        return dp[m - 1][n - 1];
    }
}

====

💡 DFS (time limit exceeded)
📊 O(n^2), O(1)

class Solution {
    private int res = 0;
    public int uniquePaths(int m, int n) {
        dfs(m, n, 0, 0);
        return res;
    }

    public void dfs(int m, int n, int i, int j) {
        if (i == m - 1 && j == n - 1) {
            res++;
            return;
        }
        if (i == m || j == n) return;
        dfs(m, n, i + 1, j);
        dfs(m, n, i, j + 1);
    }
}