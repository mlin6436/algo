💡 BFS
📊 O(m*n), O(m*n)

class Solution {
    public int[][] updateMatrix(int[][] mat) {
        int m = mat.length;
        int n = mat[0].length;
        int[][] res = new int[m][n];
        Queue<int[]> q = new LinkedList<>();
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (mat[i][j] == 0) {
                    res[i][j] = 0;
                    q.add(new int[]{i, j});
                } else {
                    res[i][j] = Integer.MAX_VALUE;
                }
            }
        }
        int[][] dirs = {{1,0},{0,1},{-1,0},{0,-1}};
        while (!q.isEmpty()) {
            int[] cur = q.poll();
            for (int[] dir : dirs) {
                int new_i = cur[0] + dir[0];
                int new_j = cur[1] + dir[1];
                if (new_i >= 0 && new_i < m && new_j >= 0 && new_j < n && res[new_i][new_j] > res[cur[0]][cur[1]] + 1) {
                    res[new_i][new_j] = res[cur[0]][cur[1]] + 1;
                    q.add(new int[]{new_i, new_j});
                }
            }
        }
        return res;
    }
}