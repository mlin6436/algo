💡 Two pointer
📊 O(n), O(1)

class Solution {
    public boolean isPalindrome(String s) {
        String temp = "";
        for (int i = 0; i < s.length(); i++) {
            char cur = s.charAt(i);
            if (cur >= '0' && cur <= '9' || cur >= 'a' && cur <= 'z' || cur >= 'A' && cur <= 'Z') {
                temp += Character.toLowerCase(cur);
            }
        }

        int left = 0; 
        int right = temp.length() - 1;
        while (left < right) {
            if (temp.charAt(left) == temp.charAt(right)) {
                left++;
                right--;
            } else {
                return false;
            }
        }
        return true;
    }
}
