💡 One-pass approach
📊 O(n), O(1)

class Solution {
    public int maxProfit(int[] prices) {
        int profit = 0;

        int sell = prices[prices.length - 1];
        for (int i = prices.length - 2; i >= 0; i--) {
            int buy = prices[i];
            if (sell <= buy) {
                sell = buy;
            } else {
                profit = sell - buy > profit ? sell - buy : profit;
            }
        }

        return profit;
    }
}

