💡 BFS
📊 O(m*n), O(n)

class Solution {
    public int numIslands(char[][] grid) {
        int m = grid.length;
        int n = grid[0].length;
        int[][] visited = new int[m][n];
        int count = 0;
        Queue<int[]> q = new LinkedList<>();
        int[][] dirs = {{-1,0},{0,-1},{1,0},{0,1}};
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (visited[i][j] == 0 && grid[i][j] == '1') {
                    q.offer(new int[]{i,j});
                    while (!q.isEmpty()) {
                        int[] cur = q.poll();
                        visited[cur[0]][cur[1]] = 1;
                        for (int[] dir : dirs) {
                            int r = cur[0] + dir[0];
                            int c = cur[1] + dir[1];
                            if (r >= 0 && r < m && c >= 0 && c < n && visited[r][c] == 0 && grid[r][c] == '1') {
                                visited[r][c] = 1;
                                q.offer(new int[]{r,c});
                            }
                        }
                    }
                    count++;
                } 
            }
        }
        return count;
    }
}