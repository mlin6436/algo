💡 Backtracking
📊 O(N^(T/M + 1)) - where N is the number of candidates, T is the target value, and M is the minimal value among the candidates.
📊 O(T/M) - due to the recursion call stack and the space needed to store the current combination

class Solution {
    public List<List<Integer>> combinationSum(int[] candidates, int target) {
        List<List<Integer>> res = new ArrayList<>();
        List<Integer> tmp = new ArrayList<>();
        bt(candidates, target, res, tmp, 0);
        return res;
    }

    public void bt(int[] candidates, int target, List<List<Integer>> res, List<Integer> tmp, int index) {
        if (target == 0) {
            res.add(new ArrayList<>(tmp));
            return;
        }
        if (target < 0) {
            return;
        }
        
        for (int i = index; i < candidates.length; i++) {
            tmp.add(candidates[i]);
            bt(candidates, target - candidates[i], res, tmp, i);
            tmp.remove(tmp.size() - 1);
        }

        return;
    }
}