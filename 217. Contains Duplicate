💡 Hash map
📊 O(n), O(n)

class Solution {
    public boolean containsDuplicate(int[] nums) {
        Map<Integer, Integer> map = new HashMap<>();
        for (int num : nums) {
            int count = map.getOrDefault(num, 0) + 1;
            if (count > 1) {
                return true;
            } else {
                map.put(num, count);
            }
        }
        return false;
    }
}